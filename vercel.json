{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm install --prefix web && npm run build --prefix web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/r/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/privacidade", "destination": "/api/index.js" },
    { "source": "/termos", "destination": "/api/index.js" }
  ]
}
