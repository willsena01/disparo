DATABASE_URL=postgres://user:password@localhost:5432/disparo
POLL_INTERVAL_MS=2000
BATCH_SIZE=10
PORT=3000
# Versão da Graph API usada no envio via Messenger
FB_GRAPH_VERSION=v21.0

# Segredo do acionamento por cron. Obrigatório em hospedagem serverless
# (Vercel), onde não há processo contínuo: o cron chama /api/cron/tick com este
# valor no header x-cron-secret, e cada chamada processa um lote de fluxos em
# espera e de destinatários de campanha.
CRON_SECRET=

# Armazenamento das mídias dos blocos. Sem isso os arquivos vão para o disco
# local — que na Vercel é apagado entre invocações, fazendo as mídias sumirem.
BLOB_READ_WRITE_TOKEN=
# URL pública da aplicação. É a base do OAuth Redirect URI e da Callback URL do
# webhook — precisa ser exatamente a mesma cadastrada no painel do Meta, e em
# HTTPS (a Meta não chama http nem localhost).
APP_BASE_URL=https://seu-dominio.com

# Quem responde legalmente pelo tratamento dos dados, na Política de Privacidade
# e nos Termos. O padrão está em src/legal.js — estas variáveis só são
# necessárias para rodar sob outra razão social. Seja qual for, precisa ser a
# MESMA empresa verificada no portfólio da Meta: a análise do app cruza os dois.
# EMPRESA_ENDERECO é opcional e aparece junto ao contato.
# EMPRESA_NOME=
# EMPRESA_EMAIL=
# EMPRESA_DOC=
# EMPRESA_ENDERECO=
